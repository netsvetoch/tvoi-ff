{
	"name": "tvoi-ff",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"browserslist": "baseline widely available with downstream",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"onFail": "download",
			"version": "12.0.0"
		},
		"runtime": {
			"name": "node",
			"onFail": "download",
			"version": "26.8.1"
		}
	},
	"packageManager": "pnpm@12.0.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b --noEmit && vite build",
		"lint": "eslint . --quiet",
		"preview": "vite preview",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc -b --noEmit",
		"lint:circular": "dpdm",
		"lint:deadcode": "knip",
		"lint:all": "concurrently \"pnpm typecheck\" \"pnpm lint\" \"pnpm format:check\" \"pnpm lint:circular\" \"pnpm lint:deadcode\""
	},
	"dependencies": {
		"@gravity-ui/date-utils": "^2.7.1",
		"@gravity-ui/navigation": "^6.4.2",
		"@reactuses/core": "^6.5.5",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-table": "^9.2.4",
		"konva": "^10.3.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-error-boundary": "^6.1.3",
		"react-hook-form": "^7.86.0",
		"react-konva": "^19.2.5",
		"use-image": "^1.1.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@gravity-ui/components": "^4.24.0",
		"@gravity-ui/icons": "^2.22.0",
		"@gravity-ui/illustrations": "^2.1.1",
		"@gravity-ui/uikit": "^7.48.3",
		"@hey-api/openapi-ts": "^0.99.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"concurrently": "^10.0.5",
		"dpdm": "^4.3.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-perfectionist": "^5.10.1",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-security": "^4.0.1",
		"eslint-plugin-unicorn": "^65.0.1",
		"jiti": "^2.7.0",
		"knip": "^6.33.0",
		"prettier": "^3.9.6",
		"sass-embedded": "^1.103.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
