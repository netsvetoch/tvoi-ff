{
	"name": "tvoi-ff",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"eslint": "eslint . --quiet",
		"eslint:fix": "eslint . --fix",
		"prettier": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"stylelint": "stylelint \"**/*.css\" --quiet",
		"stylelint:fix": "stylelint \"**/*.css\" --fix",
		"typecheck": "tsc -b",
		"circular": "dpdm --exit-code circular:1 --no-tree --no-warning --progress false --transform \"./src/app/main.tsx\"",
		"deadcode": "knip --exclude binaries,dependencies,unlisted",
		"lint": "run-p typecheck eslint stylelint prettier circular deadcode",
		"format": "npm run eslint:fix || true && npm run stylelint:fix || true && npm run prettier:fix || true",
		"openapi-ts": "bash ./generate-api.sh"
	},
	"dependencies": {
		"@gravity-ui/date-utils": "^2.6.0",
		"@gravity-ui/navigation": "^4.0.10",
		"@gravity-ui/table": "^1.15.2",
		"@tanstack/react-query": "^5.90.20",
		"ahooks": "^3.9.6",
		"konva": "^10.2.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-error-boundary": "^6.1.0",
		"react-hook-form": "^7.71.1",
		"react-konva": "^18.2.14",
		"use-image": "^1.1.4",
		"usehooks-ts": "^3.1.1"
	},
	"devDependencies": {
		"@bpa-dev/eslint-config": "^1.4.2",
		"@gravity-ui/components": "^4.18.0",
		"@gravity-ui/date-components": "^3.4.1",
		"@gravity-ui/icons": "^2.17.0",
		"@gravity-ui/illustrations": "^2.1.0",
		"@gravity-ui/uikit": "^7.31.0",
		"@hey-api/openapi-ts": "^0.91.1",
		"@types/node": "^25.2.0",
		"@types/react": "^18.3.27",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^5.1.3",
		"dpdm": "^4.0.1",
		"eslint": "^9.39.2",
		"knip": "^5.83.0",
		"npm-run-all": "^4.1.5",
		"react-router": "^7.13.0",
		"sass-embedded": "^1.97.3",
		"stylelint": "^17.1.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "npm:rolldown-vite@^7.3.1",
		"vite-plugin-mkcert": "^1.17.9",
		"vitest": "^4.0.18"
	}
}
