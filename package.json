{
	"name": "tvoi-ff",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"browserslist": "baseline widely available with downstream",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"onFail": "download",
			"version": "12.0.0"
		},
		"runtime": {
			"name": "node",
			"onFail": "download",
			"version": "26.8.1"
		}
	},
	"packageManager": "pnpm@12.0.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b --noEmit && vite build",
		"lint": "eslint . --quiet",
		"preview": "vite preview",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc -b --noEmit",
		"lint:circular": "npx dpdm --exit-code circular:1 --no-tree --no-warning --progress false --transform \"./src/app/main.tsx\"",
		"lint:deadcode": "knip --exclude binaries,dependencies,unlisted",
		"lint:all": "run-p typecheck lint format:check lint:circular lint:deadcode"
	},
	"dependencies": {
		"@gravity-ui/date-utils": "^2.7.1",
		"@gravity-ui/navigation": "^6.4.2",
		"@gravity-ui/table": "^1.20.2",
		"@tanstack/react-query": "^5.102.7",
		"ahooks": "^3.9.7",
		"konva": "^10.3.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-error-boundary": "^6.1.3",
		"react-hook-form": "^7.86.0",
		"react-konva": "^18.2.16",
		"use-image": "^1.1.4",
		"usehooks-ts": "^3.1.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@gravity-ui/components": "^4.24.0",
		"@gravity-ui/date-components": "^4.0.0",
		"@gravity-ui/icons": "^2.22.0",
		"@gravity-ui/illustrations": "^2.1.1",
		"@gravity-ui/uikit": "^7.48.3",
		"@hey-api/openapi-ts": "^0.99.0",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.1.0",
		"dpdm": "^4.3.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-perfectionist": "^5.10.1",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.5",
		"eslint-plugin-security": "^4.0.1",
		"eslint-plugin-unicorn": "^65.0.1",
		"globals": "^17.11.0",
		"jiti": "^2.7.0",
		"knip": "^6.32.3",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.9.6",
		"react-router": "^7.18.2",
		"sass-embedded": "^1.103.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vite-plugin-mkcert": "^2.1.0",
		"vitest": "^4.1.11"
	}
}
